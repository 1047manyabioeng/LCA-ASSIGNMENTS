#include <stdio.h>
#include <string.h>

int main()
{
    char str[] = "Hello World";
    int i, len;

    printf("Original String: %s\n", str);

    len = strlen(str);

    printf("Reversed String: ");
    for(i = len - 1; i >= 0; i--)
    {
        printf("%c", str[i]);
    }

    printf("\n");
    return 0;
}
}

#include <stdio.h>
#include <string.h>

int main()
{
    char str[50];
    int i;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] >= 'A' && str[i] <= 'Z')
        {
            str[i] = str[i] + 32;
        }
    }

    printf("Lowercase String: %s", str);

    return 0;
}
}

#include <stdio.h>
#include <string.h>

int main()
{
    char str[50];
    int i;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] >= 'a' && str[i] <= 'z')
        {
            str[i] = str[i] - 32;
        }
    }

    printf("Uppercase String: %s", str);

    return 0;
}
