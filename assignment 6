#include <stdio.h>
// Function to
swap two integers using pointers
void swap(int *x, int *y) {
int temp;
temp = *x; // Save the value at address x
*x = *y;
I/ Copy the value at address y into address x
*y = temp;
/I Copy the saved value into address y
}
int main() [
int a, b;
printf("Enter the first number (a): ");
scanf ("%d", &a);
printf ("Enter the second number (b): "); scanf("%d", &b) ;
printf(" oBefore
swapping: a = %d, b = %d\n", a, b);
// Pass the memory addresses of a and b to the swap function
swap(&a, &b) ;
printf("After swapping: a = %d, b = %d\n", a, b);
return 0;
}
}
