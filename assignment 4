#include <stdio.h>

int fact(int n);
int main()
{
    int n, f;

    printf("Enter the number whose factorial you want to calculate?");
    scanf("%d", &n);

    f = fact(n);

    printf("Factorial = %d", f);

    return 0;
}

int fact(int n)
{
    int i, f = 1;

    for(i = 1; i <= n; i++)
    {
        f = f * i;
    }

    return f;
}

  }
