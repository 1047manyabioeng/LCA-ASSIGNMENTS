#include <stdio.h>

struct Student
{
    int roll;
    char name[20];
    int m1, m2, m3, total;
    float percentage;
};

int main()
{
    struct Student s[10];
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter roll number, name and marks:\n");
        scanf("%d %s %d %d %d", &s[i].roll,
              s[i].name, &s[i].m1, &s[i].m2, &s[i].m3);

        s[i].total = s[i].m1 + s[i].m2 + s[i].m3;
        s[i].percentage = s[i].total / 3.0;
    }

    printf("\nRoll No\tName\tTotal\tPercentage\n");

    for(i = 0; i < n; i++)
    {
        printf("%d\t%s\t%d\t%.2f\n",
        s[i].roll, s[i].name, s[i].total, s[i].percentage);
    }

    return 0;
}
